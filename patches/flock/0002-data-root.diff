@@ -1,8 +1,8 @@
-output_dir: ~/flock/output-entity
+output_dir: {{ output_dir | default('/kgfm/output', true) }}
 
 dataset:
   class: {{ dataset }}
-  root: ~/flock/kg-datasets-entity/
