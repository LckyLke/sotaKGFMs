@@ -0,0 +1,88 @@
+"""Per-query rank dump for the shared ``ranks/`` schema.
+
+This module writes ranks. It does not produce them and it does not compute a
+metric: every number it emits was already computed by ``flock/tasks.py`` and is
+copied out unchanged. Nothing here touches dtypes, epsilons, fused operations or
+reduction order, so a run with dumping enabled ranks identically to one without.
+
+The query ordering is recovered rather than imposed. ``src_entity/run.py::test``
+builds its loader from a ``DistributedSampler`` over the test triples; a second
+``DistributedSampler`` constructed with the same (length, num_replicas, rank)
+yields the same permutation, because the permutation depends only on those and
+on the sampler's own generator seeded with ``seed + epoch`` (0 + 0 here) --
+never on the global RNG or on the tensor's contents. Consuming that permutation
+in ``batch_size`` chunks reproduces exactly what the real loader hands out,
+which lets a stable ``query_id`` be attached without altering the real loader.
+"""
+
+import os
+
+from torch.utils import data as torch_data
+
+import suite  # shared/suite.py, on PYTHONPATH; the only dataset list in the project
+
+
+class Dumper:
+    """Accumulates one row per scored query and writes a single parquet file."""
+
+    def __init__(self, spec, test_triplets, world_size, rank, batch_size):
+        if world_size != 1:
+            raise RuntimeError(
+                "rank dumping is single-process only (run with --gpus [0]); got "
+                "world_size=%d. Under DDP each rank sees a shard and the ranks "
+                "are summed together by all_reduce, which loses per-query "
+                "identity." % world_size
+            )
+        self.spec = spec
+        self.graph = suite.by_run_id(spec["dataset"])
+        # the five tail-only graphs are evaluated on tail prediction alone
+        self.tail_only = self.graph.tail_only
+        self.order = [int(i) for i in torch_data.DistributedSampler(test_triplets, world_size, rank)]
+        self.batch_size = batch_size
+        self.cursor = 0
+        self.columns = {name: [] for name in suite.RANK_COLUMNS}
+
+    def add(self, batch, t_ranking, h_ranking, num_t_negative, num_h_negative):
+        size = len(batch)
+        query_ids = self.order[self.cursor:self.cursor + size]
+        self.cursor += size
+        assert len(query_ids) == size, "sampler order desynchronised from the loader"
+
+        pos_h, pos_t, pos_r = [column.tolist() for column in batch.t()]
+        directions = [("tail", t_ranking, num_t_negative)]
+        if not self.tail_only:
+            directions.append(("head", h_ranking, num_h_negative))
+
+        for direction, ranking, num_negative in directions:
+            ranking = ranking.tolist()
+            num_negative = num_negative.tolist()
+            for i in range(size):
+                self.columns["dataset"].append(self.graph.id)
+                self.columns["model"].append(self.spec["model"])
+                self.columns["seed"].append(self.spec["seed"])
+                self.columns["direction"].append(direction)
+                self.columns["query_id"].append(query_ids[i])
+                self.columns["h"].append(pos_h[i])
+                self.columns["r"].append(pos_r[i])
+                self.columns["t"].append(pos_t[i])
+                self.columns["rank"].append(ranking[i])
+                self.columns["n_candidates"].append(num_negative[i])
+
+    def write(self):
+        import pyarrow
+        import pyarrow.parquet
+
+        arrow_types = {
+            "string": pyarrow.string(),
+            "int64": pyarrow.int64(),
+        }
+        schema = pyarrow.schema([
+            (name, arrow_types[suite.RANK_COLUMN_TYPES[name]]) for name in suite.RANK_COLUMNS
+        ])
+        table = pyarrow.table({name: self.columns[name] for name in suite.RANK_COLUMNS}, schema=schema)
+
+        os.makedirs(self.spec["dir"], exist_ok=True)
+        # ':' is legal on Linux but awkward everywhere else; metrics.py resolves both
+        path = os.path.join(self.spec["dir"], "%s.parquet" % self.graph.id.replace(":", "_"))
+        pyarrow.parquet.write_table(table, path)
+        return path
