--- a/src/evaluation.py
+++ b/src/evaluation.py
@@ -127,6 +127,10 @@ parser.add_argument('--save_path', type=str, default='../checkpoint/pretrain/')
 parser.add_argument('--seed', type=str, default=1)
 parser.add_argument('--gpu', type=str, default='0')
 parser.add_argument('--use_rspmm', type=bool, default=False)
+parser.add_argument('--rank_dump_dir', type=str, default=None,
