   loss_weights: [1.0, 1.0]
   label_smoothing: 0.1
-  context_label_correction: True
+  # K3 knobs (this project, 2026-09-02): the external plan's context
+  # ablation on the released model. context_label_correction is upstream's
+  # default True (the encoder relabels context negatives it scores above the
+  # weakest positive); off, the labels the transformer sees are exactly the
+  # sampled ones. context_shuffle_labels permutes each query's context labels
+  # among its rows (same rows, same counts, no row-label correspondence)
+  # right before the context cache is built -- the "shuffled" condition.
+  context_label_correction: {{ context_label_correction }}
+  context_shuffle_labels: {{ context_shuffle_labels }}
 
