Reason: give MOTIF its own processed root (data/roots/motif/) so the relation-graph cache in processed/data.pt cannot be shared with another repo's pre_transform. MOTIF's pre_transform builds a higher-order motif relation graph, so a shared root would hand ULTRA's relation graph to MOTIF with no error and no warning.

diff --git a/config/inductive/MOTIF_inference.yaml b/config/inductive/MOTIF_inference.yaml
index f5d35e4..ac7a8d7 100644
--- a/config/inductive/MOTIF_inference.yaml
+++ b/config/inductive/MOTIF_inference.yaml
@@ -1,8 +1,8 @@
-output_dir: ~/MOTIF/output
+output_dir: {{ output_dir | default('/kgfm/output', true) }}
 
 dataset:
   class: {{ dataset }}
-  root: ~/MOTIF/kg-datasets/
+  root: {{ data_root | default('/kgfm/data/roots/motif/', true) }}
   version: {{ version }}
 
 model:
